@article{beatrice_challenges_2023,
	title = {The {Challenges} of {HTR} {Model} {Training}: {Feedback} from the {Project} {Donner} le gout de l'archive a l'ere numerique},
	volume = {Documents historiques et reconnaissance automatique de texte},
	issn = {2416-5999},
	shorttitle = {The {Challenges} of {HTR} {Model} {Training}},
	url = {https://jdmdh.episciences.org/12556},
	doi = {10.46298/jdmdh.10542},
	abstract = {The arrival of handwriting recognition technologies offers new possibilities for research in heritage studies. However, it is now necessary to reflect on the experiences and the practices developed by research teams. Our use of the Transkribus platform since 2018 has led us to search for the most significant ways to improve the performance of our handwritten text recognition (HTR) models which are made to transcribe French handwriting dating from the 17th century. This article therefore reports on the impacts of creating transcribing protocols, using the language model at full scale and determining the best way to use base models in order to help increase the performance of HTR models. Combining all of these elements can indeed increase the performance of a single model by more than 20\% (reaching a Character Error Rate below 5\%). This article also discusses some challenges regarding the collaborative nature of HTR platforms such as Transkribus and the way researchers can share their data generated in the process of creating or training handwritten text recognition models.},
	urldate = {2026-02-10},
	journal = {Journal of Data Mining \& Digital Humanities},
	publisher = {Episciences.org},
	author = {Beatrice, Couture and Farah, Verret and Maxime, Gohier and Dominique, Deslandres},
	month = dec,
	year = {2023},
	annote = {parle de transkribus, interessant et API accessible. 
},
	file = {Full Text PDF:C\:\\Users\\Topo_4\\Zotero\\storage\\7MDPVCUX\\Beatrice et al. - 2023 - The Challenges of HTR Model Training Feedback from the Project Donner le gout de l'archive a l'ere.pdf:application/pdf},
}

@incollection{stokes_partage_nodate,
	title = {Partage de données pour la reconnaissance de texte manuscrit ({HTR})},
	abstract = {La reconnaissance de texte manuscrit (RTM) est actuellement sans doute la principale application de l'intelligence artificielle aux humanités numériques. Elle relève de l'apprentissage automatique supervisé, lequel dépend presque entièrement des données utilisées pour l'entraînement. Les conséquences sont nombreuses : ces techniques sont donc positivistes, dans la mesure où elles ne s'appliquent qu'aux cas où la réponse peut être connue et définie à l'avance ; elles reflètent nécessairement les pratiques historiques ; et elles reflètent également tous les biais inévitables présents dans les données (voir par exemple Brown et al., 2020, p. 36-39). Les données elles-mêmes acquièrent une valeur intrinsèque et, inversement, leur disponibilité influence les choix d'applications en apprentissage automatique. Pour la RTM, cela signifie que les progrès les plus importants ont été réalisés sur des documents modernes, dans des langues et systèmes d'écriture largement répandus comme l'anglais et d'autres langues utilisant l'alphabet latin, tandis que les écritures dites rares et historiques ont connu un succès bien moindre. Cela suggère également de nombreux avantages collectifs liés à la publication et au partage des données de formation, afin de mutualiser les efforts et les expertises et d'éviter les redondances. Un tel partage soulève de nombreux défis, car il exige des normes, ou au moins des pratiques communes, en matière de transcription (notamment le traitement des abréviations, de la ponctuation, de l'orthographe et de la mise en majuscules non standardisées, etc.), ainsi que des normes de partage de données qui tiennent compte des nombreuses variations importantes des systèmes d'écriture à travers le monde. Cela suppose également la volonté (et la possibilité) de partager ouvertement les données, y compris les transcriptions et les images, ce qui peut dépendre de nombreuses institutions et intérêts différents. Malgré ces difficultés, certaines initiatives ont commencé à ouvrir la voie, et les bénéfices de ces travaux se font déjà sentir, ce qui est encourageant pour l'avenir du domaine.},
	booktitle = {Guide pratique des humanités numériques},
	author = {Stokes, Peter},
	note = {Num Pages: 10},
	file = {Full Text PDF:C\:\\Users\\Topo_4\\Zotero\\storage\\MX6NLBAW\\Stokes - Partage de données pour la reconnaissance de texte manuscrit (HTR).pdf:application/pdf},
}

@misc{tarride_improving_2024,
	title = {Improving {Automatic} {Text} {Recognition} with {Language} {Models} in the {PyLaia} {Open}-{Source} {Library}},
	url = {http://arxiv.org/abs/2404.18722},
	doi = {10.48550/arXiv.2404.18722},
	abstract = {PyLaia is one of the most popular open-source software for Automatic Text Recognition (ATR), delivering strong performance in terms of speed and accuracy. In this paper, we outline our recent contributions to the PyLaia library, focusing on the incorporation of reliable confidence scores and the integration of statistical language modeling during decoding. Our implementation provides an easy way to combine PyLaia with n-grams language models at different levels. One of the highlights of this work is that language models are completely auto-tuned: they can be built and used easily without any expert knowledge, and without requiring any additional data. To demonstrate the significance of our contribution, we evaluate PyLaia's performance on twelve datasets, both with and without language modelling. The results show that decoding with small language models improves the Word Error Rate by 13\% and the Character Error Rate by 12\% in average. Additionally, we conduct an analysis of confidence scores and highlight the importance of calibration techniques. Our implementation is publicly available in the official PyLaia repository at https://gitlab.teklia.com/atr/pylaia, and twelve open-source models are released on Hugging Face.},
	urldate = {2026-02-12},
	publisher = {arXiv},
	author = {Tarride, Solène and Schneider, Yoann and Generali-Lince, Marie and Boillet, Mélodie and Abadie, Bastien and Kermorvant, Christopher},
	month = apr,
	year = {2024},
	note = {arXiv:2404.18722 [cs]},
	keywords = {PYLAIA, Computer Science - Computation and Language, Computer Science - Computer Vision and Pattern Recognition},
	file = {Full Text PDF:C\:\\Users\\Topo_4\\Zotero\\storage\\7SGWQ8WC\\Tarride et al. - 2024 - Improving Automatic Text Recognition with Language Models in the PyLaia Open-Source Library.pdf:application/pdf;Snapshot:C\:\\Users\\Topo_4\\Zotero\\storage\\XSDFYWGS\\2404.html:text/html},
}

@misc{sang_ree-hdsc_2024,
	title = {{REE}-{HDSC}: {Recognizing} {Extracted} {Entities} for the {Historical} {Database} {Suriname} {Curacao}},
	shorttitle = {{REE}-{HDSC}},
	url = {http://arxiv.org/abs/2401.02972},
	doi = {10.48550/arXiv.2401.02972},
	abstract = {We describe the project REE-HDSC and outline our efforts to improve the quality of named entities extracted automatically from texts generated by hand-written text recognition (HTR) software. We describe a six-step processing pipeline and test it by processing 19th and 20th century death certificates from the civil registry of Curacao. We find that the pipeline extracts dates with high precision but that the precision of person name extraction is low. Next we show how name precision extraction can be improved by retraining HTR models with names, post-processing and by identifying and removing incorrect names.},
	urldate = {2026-02-12},
