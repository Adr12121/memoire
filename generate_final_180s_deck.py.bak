    p = tf.paragraphs[0]
    p.text = htext
    p.alignment = PP_ALIGN.CENTER
    r = p.runs[0]
    r.font.name = "Arial"
    r.font.size = Pt(9.0)
    r.font.bold = True
    r.font.color.rgb = C_WHITE
    hx += cw18[hi]

for ri, row in enumerate(rows18):
