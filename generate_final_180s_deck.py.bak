    rx = tx18
    for ci, cell in enumerate(row):
        c_box = s18.shapes.add_shape(MSO_SHAPE.ROUNDED_RECTANGLE, Inches(rx), Inches(ry), Inches(cw18[ci]), Inches(rh18))
